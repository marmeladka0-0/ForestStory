--- !u!114 &635922122
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 635922121}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 19cf734918d4ef74892dc3df3e4ad98d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  objectName: Grandmother
  interactionHint: {fileID: 0}
  dialogueArtwork: {fileID: 3551427753158594504, guid: 82231469d4ebe3845b02b5619d5e2ee7, type: 3}
  npcAvatar: {fileID: -1929942739836287847, guid: da6ab02311d029c4aab2892f8d676212, type: 3}
  interactionRadius: 1.2
  greetingLine:
    speaker: 0
    text: Hello! What would you like to ask?
  topics:
  - topicName: Ask about a key
    isGoodbye: 0
    lines:
    - speaker: 1
      text: Excuse me, do you know where we can find the old cottage key?
    - speaker: 0
      text: Ah, the rusty iron key! It was lost near the ancient pond many years
        ago.
    - speaker: 1
      text: Is it safe for us to go to the pond right now?
    - speaker: 0
      text: Beware of the thick fog around the water. Keep your lantern bright!
    - speaker: 1
      text: Thank you for the warning, we will be very careful.
  - topicName: Ask about the recipe
    isGoodbye: 0
    lines:
    - speaker: 1
      text: Can you tell us about the herbal tea recipe you mentioned earlier?
    - speaker: 0
      text: Of course! You will need blue moonflowers and dried pine berries.
    - speaker: 0
      text: Brew them over a slow fire, and the drink will restore your strength.
    - speaker: 1
      text: Sounds delicious! We will look for those ingredients on our way.
  - topicName: Ask about the forest
    isGoodbye: 0
    lines:
    - speaker: 1
      text: Why is everyone in the village so afraid of the deep forest?
    - speaker: 0
      text: Strange shadows wander between the trees after sunset, confusing travelers.
    - speaker: 1
      text: We are not afraid. As long as we stick together, we can pass through.
    - speaker: 0
      text: Brave words! Just remember never to stray from the main dirt path.
  - topicName: Say goodbye
    isGoodbye: 1
    lines:
    - speaker: 1
      text: We must continue our journey now. Farewell!
    - speaker: 0
      text: May the forest light guide your steps, travelers. Take care!
  dialogueWindow: {fileID: 1745520162}
